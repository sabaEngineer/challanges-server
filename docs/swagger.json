  },
  "info": {
    "title": "Challenges.me API",
    "description": "Social habit and challenge platform API",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "firstName": {
            "type": "string",
            "description": "First name",
            "example": "John"
          },
          "lastName": {
            "type": "string",
            "description": "Last name",
            "example": "Doe"
          },
          "picture": {
            "type": "string",
            "description": "Profile picture URL"
          },
          "pushToken": {
            "type": "string",
            "description": "Push notification token"
          },
          "skip_build_team": {
            "type": "boolean",
            "description": "When true, skip \"build your team\" flow and go directly to join pack (for returning users)"
          }
        }
      },
      "GoogleAuthDto": {
        "type": "object",
        "properties": {
          "idToken": {
            "type": "string",
            "description": "Google ID token obtained from the mobile client",
            "example": "eyJhbGciOiJSUzI1NiIsInR5cCI6..."
          }
        },
        "required": [
          "idToken"
        ]
      },
      "AuthUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "firstName": {
            "type": "string",
            "nullable": true
          },
          "lastName": {
            "type": "string",
            "nullable": true
          },
          "picture": {
            "type": "string",
            "nullable": true
          },
          "skip_build_team": {
            "type": "boolean",
            "description": "When true, skip \"build your team\" flow and go directly to join pack"
          }
        },
        "required": [
          "id",
          "email",
          "firstName",
          "lastName",
          "picture",
          "skip_build_team"
        ]
      },
      "AuthResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/AuthUserDto"
          }
        },
        "required": [
          "accessToken",
          "user"
        ]
      },
      "PresignedUrlRequestDto": {
        "type": "object",
        "properties": {
          "fileName": {
            "type": "string",
            "description": "Original file name",
            "example": "photo.jpg"
          },
          "mimeType": {
            "type": "string",
            "description": "MIME type of the file",
            "example": "image/jpeg"
          },
          "folder": {
            "type": "string",
            "description": "Upload folder/category",
            "enum": [
              "profile",
              "checkin",
              "challenge",
              "message"
            ],
            "example": "checkin"
          }
        },
        "required": [
          "fileName",
          "mimeType",
          "folder"
        ]
      },
      "PresignedUrlResponseDto": {
        "type": "object",
        "properties": {
          "uploadUrl": {
            "type": "string",
            "description": "Pre-signed URL for uploading the file to S3"
          },
          "fileUrl": {
            "type": "string",
            "description": "Public URL via CloudFront to access the file after upload"
          },
          "key": {
            "type": "string",
            "description": "S3 storage key"
          }
        },
        "required": [
          "uploadUrl",
          "fileUrl",
          "key"
        ]
      },
      "CreateChallengeDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Challenge title",
            "example": "30 Days of Meditation"
          },
          "description": {
            "type": "string",
            "description": "Challenge description"
          },
          "imageUrl": {
            "type": "string",
            "description": "Challenge image URL"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "public",
              "teammates_only",
              "private_invite"
            ],
            "default": "public"
          },
          "type": {
            "type": "string",
            "enum": [
              "strict",
              "flexible"
            ],
            "example": "strict"
          },
          "media_requirement": {
            "type": "string",
            "enum": [
              "none",
              "image_or_video_required",
              "image_required",
              "video_required"
            ],
            "default": "none"
          },
          "start_date": {
            "type": "string",
            "description": "Start date (YYYY-MM-DD)",
            "example": "2026-03-01"
          },
          "end_date": {
            "type": "string",
            "description": "End date (YYYY-MM-DD)",
            "example": "2026-03-31"
          }
        },
        "required": [
          "title",
          "visibility",
          "type",
          "media_requirement",
          "start_date"
        ]
      },
      "UpdateChallengeDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "description": "Challenge title"
          },
          "description": {
            "type": "string",
            "description": "Challenge description"
          },
          "imageUrl": {
            "type": "string",
            "description": "Challenge image URL"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "public",
              "teammates_only",
              "private_invite"
            ]
          },
          "media_requirement": {
            "type": "string",
            "enum": [
              "none",
              "image_or_video_required",
              "image_required",
              "video_required"
            ]
          },
          "end_date": {
            "type": "string",
            "description": "End date (YYYY-MM-DD)"
          }
        }
      },
      "CheckinMediaItemDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "image",
              "video"
            ]
          },
          "url": {
            "type": "string",
            "description": "URL of the uploaded image or video"
          }
        },
        "required": [
          "type",
          "url"
        ]
      },
      "UpdateCheckinDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "success",
              "failed"
            ],
            "description": "success or failed"
          },
          "text": {
            "type": "string",
            "description": "Optional text note"
          },
          "media": {
            "description": "Replace media. Each item: { type: \"image\" | \"video\", url: string }",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CheckinMediaItemDto"
            }
          }
        }
      },
      "CreateCheckinDto": {
        "type": "object",
        "properties": {
          "checkin_date": {
            "type": "string",
            "description": "Date of the check-in (YYYY-MM-DD). Defaults to today.",
            "example": "2026-03-15"
          },
          "status": {
            "type": "string",
            "enum": [
              "success",
              "failed"
            ],
            "description": "success or failed"
          },
          "text": {
            "type": "string",
            "description": "Optional text note"
          },
          "media": {
            "description": "Optional media (images/videos) attached to the check-in",
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CheckinMediaItemDto"
            }
          }
        },
        "required": [
          "status"
        ]
      },
      "SendTeammateRequestDto": {
        "type": "object",
        "properties": {
          "addressee_id": {
            "type": "string",
            "description": "User ID to send team up request to"
          }
        },
        "required": [
          "addressee_id"
        ]
      },
      "RespondTeammateRequestDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "accepted",
              "declined",
              "canceled",
              "blocked"
            ],
            "description": "Response: accepted, declined, or canceled"
          }
        },
        "required": [
          "status"
        ]
      },
      "CreateConversationDto": {
        "type": "object",
        "properties": {
          "teammate_id": {
            "type": "string",
            "description": "Teammate user ID to start conversation with"
          }
        },
        "required": [
          "teammate_id"
        ]
      },
      "SendMessageDto": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "text",
              "image",
              "system"
            ],
            "default": "text"
          },
          "text": {
            "type": "string",
            "description": "Message text (for text type)"
          },
          "image_url": {
            "type": "string",
            "description": "Image URL (for image type)"
          },
          "image_storage_key": {
            "type": "string",
            "description": "S3 storage key (for image type)"
          },
          "image_mime_type": {
            "type": "string",
            "description": "Image MIME type"
          },
          "image_size_bytes": {
            "type": "number",
            "description": "Image size in bytes"
          },
          "image_width": {
            "type": "number",
            "description": "Image width"
          },
          "image_height": {
            "type": "number",
            "description": "Image height"
          }
        }
      }
    }
  }
}